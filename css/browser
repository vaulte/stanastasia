/* Ravenswood Internet — Browser Chrome */
.browser{
  height:100%;
  display:flex;
  flex-direction:column;
  background:#dfe3ea;
}

.tabs{
  height:54px;
  display:flex;
  align-items:flex-end;
  padding-left:8px;
  background:#d6dae2;
  border-bottom:1px solid #888;
}

.tab{
  display:flex;
  align-items:center;
  gap:10px;
  background:#f4f4f4;
  border:1px solid #666;
  border-bottom:none;
  padding:14px 16px;
  margin-right:4px;
  font-size:14px;
  min-width:240px;
}

.tab.active{
  background:#ffffff;
}

.tab .icon{
  width:16px;
  height:16px;
  background:#ff6600;
  border-radius:2px;
}

.tab .close{
  margin-left:auto;
  font-weight:bold;
  color:#333;
}

.new-tab{
  font-size:26px;
  padding:8px 14px;
  color:#333;
}

.toolbar{
  height:38px;
  background:#ececec;
  border-bottom:1px solid #999;
  display:flex;
  align-items:center;
  padding:0 10px;
  gap:8px;
}

.navbtn{
  width:24px;
  height:24px;
  border:1px solid #888;
  background:#f7f7f7;
}

.addressbar{
  flex:1;
  height:26px;
  border:1px solid #888;
  background:#fff;
  font-family:"Courier New", monospace;
  font-size:13px;
  color:#222;
  overflow:hidden;
  white-space:nowrap;
  text-overflow:ellipsis;
  padding-left:10px;
  padding-top:5px;
}

.viewport{
  flex:1;
  overflow:auto;
  background:#d9d9d9;
  padding:14px;
}

.forum{
  width:1120px;
  margin:0 auto;
  background:#fff;
  border:1px solid #444;
  box-shadow:0 2px 6px rgba(0,0,0,.08);
}

.tab .icon-red{ background:#cc3333; }
.tab .icon-gray{ background:#777; }
